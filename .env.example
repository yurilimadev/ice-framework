# Modelo de configuracao de envio de email.
# Copie este arquivo para .env e preencha com valores reais.
# O .env nao vai para o git (regra no .gitignore).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=senhadeappde16letras
SMTP_FROM=seuemail@gmail.com
DIGEST_TO=destino@email.com

